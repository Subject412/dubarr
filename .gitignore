# Media fixtures & runtime data — never commit.
# Media lives only in the fixture/runtime dirs below (testfiles/, data/,
# /work/, /vault/), so no media extension globs are needed here. Do NOT add
# globs like *.ts: that would silently ignore TypeScript sources repo-wide.
testfiles/
data/
/work/
/vault/
*.bak

# Build artifacts (expanded at bootstrap)
node_modules/
dist/
target/
/bin/
/backend/dubarr
*.db
*.db-*
*.sqlite
*.sqlite-*
.env

# Docker appliance runtime dirs (compose bind mounts)
/docker/config/
/docker/media/

# Secrets & keys — never commit
.master.key
*.keyfile
.hermes/
