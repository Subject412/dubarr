# Example values for docker/docker-compose.example.yml.
#
#   cp .env.example .env
#
# Compose loads .env from this directory automatically. These are non-default
# host settings; see docker/README.md for every variable and its default.
# Application settings and secrets do NOT belong here (ADR-0003).

# uid/gid the container process runs as. Must be able to write ./config and
# read MEDIA_PATH. Find yours with `id -u` / `id -g`.
PUID=1001
PGID=1001

# Host directory holding the media library, mounted read-only at /media.
MEDIA_PATH=/srv/media/library

# Host port for the web UI. The container always listens on 8080.
DUBARR_PORT=8090
